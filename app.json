{
  "expo": {
    "name": "Leavy",
    "slug": "leavy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.langchen.leavy",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.langchen.leavy",
      "permissions": [
        "READ_CALENDAR",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Leavy reads your upcoming events to work out when you need to head out."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Leavy uses your location to estimate travel time to your next event."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      "expo-apple-authentication"
    ],
    "scheme": "leavy",
    "experiments": {
      "typedRoutes": true
    }
  }
}
